        def k_annotated(x: torch.Tensor) -> torch.Tensor:
            """Use annotated assignment."""
            out = torch.empty_like(x)
            for tile in hl.tile(x.size()):
                out[tile] = x[tile] * 2.0
            # Annotated assignment
            result: torch.Tensor = out.sum(dim=1)  # 1D tensor
            return result
    
